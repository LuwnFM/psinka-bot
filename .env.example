# PsIInka Bot environment template
# На Cybrancee эти значения рекомендуется задавать в Startup/Environment variables панели,
# а не создавать реальный .env в публичном GitHub-репозитории.

# Discord
DISCORD_TOKEN=your_discord_bot_token_here
OWNER_ID=0
REQUIRED_ROLE_ID=0

# AI providers (optional, but Groq/OpenRouter improve reliability)
GROQ_TOKEN=
OPENR_TOKEN=

# PostgreSQL / Neon (optional; model success history is disabled if empty)
DATABASE_URL=

# Runtime
MAX_CONCURRENT=2
PROXY_REFRESH_HOURS=6
USE_PROXY=false
DEBUG=false

# Legacy/other-host compatibility flag. Usually false/unused on Cybrancee.
RAILWAY=false
